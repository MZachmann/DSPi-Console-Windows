<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DSPiConsole.TestSignalsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Test Signal Generator">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,20,0,12">
            <StackPanel Spacing="16" Padding="0,0,20,0">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Test Signal Generator" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Onboard tone, noise and sweep generator for calibration"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Not-supported notice -->
                <InfoBar x:Name="UnsupportedBar" IsOpen="False" IsClosable="False"
                         Severity="Informational" Title="Not available"
                         Message="This firmware does not include the test signal generator."/>

                <StackPanel x:Name="BodyPanel" Spacing="16">

                    <!-- Signal type grid -->
                    <StackPanel Margin="0,-8,0,0">
                        <GridView x:Name="TypeGrid" SelectionMode="Single"
                                  IsItemClickEnabled="False"
                                  SelectionChanged="OnTypeSelectionChanged"
                                  SizeChanged="OnTypeGridSizeChanged"
                                  HorizontalAlignment="Stretch"
                                  Padding="0" Margin="0">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="66" CornerRadius="6" Margin="4"
                                            HorizontalAlignment="Stretch"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <Path Data="{Binding Waveform}"
                                                  Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                  StrokeThickness="1.5" Stretch="None"
                                                  Width="60" Height="28"
                                                  HorizontalAlignment="Center"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       LineHeight="13" MaxWidth="108"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <!-- Output channels -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Channels" FontWeight="Medium" VerticalAlignment="Center"/>
                            <DropDownButton x:Name="ChannelPresets" Grid.Column="1" Content="Presets"
                                            Padding="8,2,8,2" FontSize="12"/>
                        </Grid>
                        <TextBlock Text="Route the generated signal to one or more outputs. Right-click a selected channel to invert its polarity (shown amber)."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel x:Name="ChannelHost" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Per-type parameters (built in code) -->
                    <StackPanel x:Name="ParamHost" Spacing="10"/>

                    <!-- Level -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Level" FontWeight="Medium"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LevelSlider" Minimum="-120" Maximum="0" StepFrequency="1"
                                    ValueChanged="OnLevelChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <!-- Committed on Enter / focus loss: applying per keystroke
                                     would send "-3" on the way to "-30". -->
                                <TextBox x:Name="LevelBox" Width="52"
                                         LostFocus="OnLevelCommit" KeyDown="OnLevelKeyDown"/>
                                <TextBlock Text="dB" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Timing (built in code, depends on timing model) -->
                    <StackPanel x:Name="TimingHost" Spacing="10"/>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Options -->
                    <StackPanel x:Name="OptionsPanel" Spacing="4">
                        <TextBlock Text="Options" FontWeight="Medium"/>
                        <CheckBox x:Name="RawToggle" Content="Raw (skip DSP processing)" Checked="OnFlagChanged" Unchecked="OnFlagChanged"/>
                        <CheckBox x:Name="DecorrToggle" Content="Decorrelate channels" Checked="OnFlagChanged" Unchecked="OnFlagChanged"/>
                        <CheckBox x:Name="WalkToggle" Content="Walk (one channel at a time)" Checked="OnFlagChanged" Unchecked="OnFlagChanged"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Transport bar -->
        <Border Grid.Row="1" x:Name="TransportBar"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Idle" FontWeight="Medium"/>
                    <TextBlock x:Name="StatusDetail" Text="" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="StartStopButton" Grid.Column="1" Content="Start"
                        Style="{ThemeResource AccentButtonStyle}" MinWidth="90"
                        Click="OnStartStopClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
