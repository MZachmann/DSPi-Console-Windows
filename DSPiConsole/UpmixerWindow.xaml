<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DSPiConsole.UpmixerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stereo Upmixer">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20,20,0,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,20,0">

                <!-- Header: title + enable -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F5;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Stereo Upmixer" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Derive centre and surround channels from a stereo input"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="EnableToggle" Grid.Column="2" OnContent="On" OffContent="Off"
                                  Toggled="OnEnableToggled" MinWidth="0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                </Grid>

                <InfoBar x:Name="UnsupportedBar" IsOpen="False" IsClosable="False"
                         Severity="Informational" Title="Not available"
                         Message="This device does not include the stereo upmixer (requires RP2350 firmware with wire format V25 or newer)."/>

                <StackPanel x:Name="BodyPanel" Spacing="16">

                    <InfoBar x:Name="ParkedBar" IsOpen="False" IsClosable="False"
                             Severity="Warning" Title="Upmixer idle"/>

                    <!-- Live telemetry (0x4E @ 10 Hz) -->
                    <StackPanel x:Name="StatusPanel" Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Correlation" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar x:Name="CorrBar" Grid.Column="1" Minimum="0" Maximum="100"
                                         VerticalAlignment="Center"/>
                            <TextBlock x:Name="CorrText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                       TextAlignment="Right" HorizontalAlignment="Stretch"
                                       FontFamily="Cascadia Code, Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBlock Grid.Row="1" Text="Centre" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar x:Name="CenterBar" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100"
                                         VerticalAlignment="Center"/>
                            <TextBlock x:Name="CenterText" Grid.Row="1" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                       TextAlignment="Right" HorizontalAlignment="Stretch"
                                       FontFamily="Cascadia Code, Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBlock Grid.Row="2" Text="Surround L" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar x:Name="LsBar" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"
                                         VerticalAlignment="Center"/>
                            <TextBlock x:Name="LsText" Grid.Row="2" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                       TextAlignment="Right" HorizontalAlignment="Stretch"
                                       FontFamily="Cascadia Code, Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBlock Grid.Row="3" Text="Surround R" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar x:Name="RsBar" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100"
                                         VerticalAlignment="Center"/>
                            <TextBlock x:Name="RsText" Grid.Row="3" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                       TextAlignment="Right" HorizontalAlignment="Stretch"
                                       FontFamily="Cascadia Code, Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <TextBlock Text="Route the derived channels in the Matrix Mixer: the Upmix C / Ls / Rs rows appear there while the upmixer runs. Centre can reach +3 dBFS; set its crosspoint gain to -3 dB if the chain has no headroom."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- ── Centre engine ── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Centre" FontWeight="SemiBold"/>
                            <TextBlock Text="Extract centre-panned content to a real centre speaker."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Wire values 0/1 (PASSIVE/ADAPTIVE); displayed with the
                             product mode names Sinner / Logician. -->
                        <ComboBox x:Name="CenterModeCombo" Grid.Column="1" Width="120" VerticalAlignment="Center"
                                  SelectionChanged="OnCenterModeChanged">
                            <ComboBoxItem Content="Sinner"/>
                            <ComboBoxItem Content="Logician"/>
                        </ComboBox>
                    </Grid>

                    <!-- Strength -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Strength" FontWeight="Medium"/>
                        <TextBlock Text="Centre extraction amount; also scales the removal from L/R."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                    ValueChanged="OnStrengthChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="StrengthBox" Width="50" TextChanged="OnStrengthText"/>
                                <TextBlock Text="%" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Width -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Centre Width" FontWeight="Medium"/>
                        <TextBlock Text="How much extracted centre stays in L/R. 0 = discrete centre; 100 = L/R untouched (combing risk with a real centre speaker)."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="WidthSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                    ValueChanged="OnWidthChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="WidthBox" Width="50" TextChanged="OnWidthText"/>
                                <TextBlock Text="%" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Presence -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Presence" FontWeight="Medium"/>
                        <TextBlock Text="Centre presence bell at 3 kHz: negative moves voices back, positive brings them forward."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PresenceSlider" Minimum="-12" Maximum="12" StepFrequency="0.5"
                                    ValueChanged="OnPresenceChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="PresenceBox" Width="50" TextChanged="OnPresenceText"/>
                                <TextBlock Text="dB" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Adaptive-only steering controls -->
                    <StackPanel x:Name="AdaptiveCenterPanel" Spacing="16">

                        <!-- Threshold -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Correlation Threshold" FontWeight="Medium"/>
                            <TextBlock Text="Centre presence below this extracts nothing; raise to extract only strongly-correlated content."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ThresholdSlider" Minimum="0" Maximum="95" StepFrequency="1"
                                        ValueChanged="OnThresholdChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                    <TextBox x:Name="ThresholdBox" Width="50" TextChanged="OnThresholdText"/>
                                    <TextBlock Text="%" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Attack / Release -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Attack" FontWeight="Medium"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="AttackSlider" Minimum="1" Maximum="500" StepFrequency="1"
                                            ValueChanged="OnAttackChanged"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                        <TextBox x:Name="AttackBox" Width="50" TextChanged="OnAttackText"/>
                                        <TextBlock Text="ms" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Release" FontWeight="Medium"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="ReleaseSlider" Minimum="5" Maximum="2000" StepFrequency="5"
                                            ValueChanged="OnReleaseChanged"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                        <TextBox x:Name="ReleaseBox" Width="50" TextChanged="OnReleaseText"/>
                                        <TextBlock Text="ms" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Detector HPF -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Detector Bass Cut" FontWeight="Medium"/>
                            <TextBlock Text="The steering detector ignores content below this corner (bass correlates by coincidence); the audio itself is not filtered."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DetHpfSlider" Minimum="20" Maximum="1000" StepFrequency="5"
                                        ValueChanged="OnDetHpfChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                    <TextBox x:Name="DetHpfBox" Width="50" TextChanged="OnDetHpfText"/>
                                    <TextBlock Text="Hz" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- ── Surround engine ── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Surround" FontWeight="SemiBold"/>
                            <TextBlock Text="Steer ambience to rear speakers with built-in delay, band-limit and decorrelation."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Wire values 0/1/2 (OFF/PASSIVE/ADAPTIVE); displayed with
                             the product mode names Sinner / Logician. -->
                        <ComboBox x:Name="SurroundModeCombo" Grid.Column="1" Width="120" VerticalAlignment="Center"
                                  SelectionChanged="OnSurroundModeChanged">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="Sinner"/>
                            <ComboBoxItem Content="Logician"/>
                        </ComboBox>
                    </Grid>

                    <StackPanel x:Name="SurroundPanel" Spacing="16">

                        <!-- Delay -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Surround Delay" FontWeight="Medium"/>
                            <TextBlock Text="Haas precedence delay on the rears; roughly 1 ms per foot of listener distance."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SurDelaySlider" Minimum="0" Maximum="20" StepFrequency="0.5"
                                        ValueChanged="OnSurDelayChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                    <TextBox x:Name="SurDelayBox" Width="50" TextChanged="OnSurDelayText"/>
                                    <TextBlock Text="ms" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Band limit -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="High-Pass" FontWeight="Medium"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SurHpfSlider" Minimum="20" Maximum="2000" StepFrequency="10"
                                            ValueChanged="OnSurHpfChanged"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                        <TextBox x:Name="SurHpfBox" Width="54" TextChanged="OnSurHpfText"/>
                                        <TextBlock Text="Hz" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Low-Pass" FontWeight="Medium"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SurLpfSlider" Minimum="1000" Maximum="20000" StepFrequency="100"
                                            ValueChanged="OnSurLpfChanged"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                        <TextBox x:Name="SurLpfBox" Width="54" TextChanged="OnSurLpfText"/>
                                        <TextBlock Text="Hz" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Decorrelation -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Decorrelation" FontWeight="Medium"/>
                            <TextBlock Text="Allpass decorrelator amount; diffuses the rears so they do not localize."
                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DecorrSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                        ValueChanged="OnDecorrChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                    <TextBox x:Name="DecorrBox" Width="50" TextChanged="OnDecorrText"/>
                                    <TextBlock Text="%" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
