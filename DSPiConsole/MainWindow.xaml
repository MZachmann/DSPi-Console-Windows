<Window
    x:Class="DSPiConsole.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DSPiConsole"
    xmlns:controls="using:DSPiConsole.Controls"
    xmlns:converters="using:DSPiConsole.Converters"
    xmlns:models="using:DSPiConsole.Core.Models"
    Title="DSPi Console">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TitleBarMenuButton" Grid.Column="0" VerticalAlignment="Center"
                    Padding="6" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE700;" FontSize="14"/>
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnMainMenuOpening">
                        <MenuFlyoutItem Text="Import Filters..." Click="OnImportFiltersClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="I"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Export Filters..." Click="OnExportFiltersClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="E"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutSubItem x:Name="AutoEQMenu" Text="AutoEQ">
                            <MenuFlyoutItem Text="Browse Profiles..." Click="OnAutoEQBrowseClick">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="B"/>
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Update Database..." Click="OnAutoEQUpdateClick"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutSubItem x:Name="AutoEQFavoritesMenu" Text="Favorites"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Loudness Compensation..." Click="OnLoudnessClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="L"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Crossfeed..." Click="OnCrossfeedClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="C"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Matrix Mixer..." Click="OnMatrixMixerClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="M"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Stats for nerbs" Click="OnStatsClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="T"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Bulk Endpoint Monitor..." Click="OnBulkMonitorClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="B"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Settings..." Click="OnSettingsClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Save Preset" Click="OnSavePresetClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="S"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveMasterVolumeMenuItem" Text="Save Master Volume"
                                        Click="OnSaveMasterVolumeClick"/>
                        <MenuFlyoutItem Text="Revert Preset..." Click="OnRevertPresetClick"/>
                        <MenuFlyoutItem Text="Factory Reset..." Click="OnFactoryResetClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Update Firmware..." Click="OnUpdateFirmwareClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Exit" Click="OnExitClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Menu" Key="F4"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock x:Name="AppTitleText" Grid.Column="1" Text="DSPi Console"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Grid x:Name="RootGrid" Grid.Row="1">
            <Grid.Resources>
                <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
                <converters:ChannelToBrushConverter x:Key="ChannelToBrush" />
                <converters:FloatFormatConverter x:Key="FloatFormat" />

                <!-- Inline channel name textbox style - for in-place renaming -->
                <Style x:Key="ChannelNameTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="ContentElement"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="{TemplateBinding Padding}"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              IsTabStop="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <!-- Inline value textbox style - no visual feedback -->
                <Style x:Key="InlineValueTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="ContentElement"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="{TemplateBinding Padding}"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              IsTabStop="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="2,0,2,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextAlignment" Value="Right" />
                </Style>
            </Grid.Resources>

            <!--This determines the sidebar width-->
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" MinWidth="200" MaxWidth="300" />
				<ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Hidden focus sink - no visual feedback -->
            <Border x:Name="FocusSink" IsTabStop="True" Background="Transparent"
                    Width="0" Height="0" Opacity="0" Grid.Column="0" Grid.ColumnSpan="2" />

            <Grid Grid.Column="0" x:Name="SidebarGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- This is where we set the inpupt and output channel text padding and styles-->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12">
                        <TextBlock Text="INPUTS" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorGhostlyBrush}" Margin="0,8,0,4" />
                        <ListView x:Name="InputChannelsList" SelectionMode="Single" Margin="-12,0,-12,0" Padding="0"
                                  IsMultiSelectCheckBoxEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="22,0,12,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock Text="OUTPUTS" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorGhostlyBrush}" Margin="0,16,0,4" />
                        <ListView x:Name="OutputChannelsList" SelectionMode="Single" Margin="-12,0,-12,0" Padding="0">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection/>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="22,0,12,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Padding="12,12,12,0" Spacing="12">
                    <!-- Shortcut icons row -->
                    <Grid Margin="-12,0,-12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                        <Border x:Name="SidebarMatrixMixerBtn" Grid.Column="0" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarMatrixMixerTapped"
                                ToolTipService.ToolTip="Matrix Mixer"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="MatrixMixerIcon" Glyph="&#xE71D;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarSettingsBtn" Grid.Column="1" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarSettingsTapped"
                                ToolTipService.ToolTip="Settings"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarLoudnessBtn" Grid.Column="2" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarLoudnessTapped"
                                RightTapped="OnSidebarLoudnessRightClick"
                                ToolTipService.ToolTip="Loudness Compensation (right-click for settings)"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="LoudnessIcon" Glyph="&#xE708;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarCrossfeedBtn" Grid.Column="3" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarCrossfeedTapped"
                                RightTapped="OnSidebarCrossfeedRightClick"
                                ToolTipService.ToolTip="Crossfeed (right-click for settings)"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="CrossfeedIcon" Glyph="&#xE8AB;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarLevellerBtn" Grid.Column="4" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarLevellerTapped"
                                RightTapped="OnSidebarLevellerRightClick"
                                ToolTipService.ToolTip="Volume Leveller (right-click for settings)"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="LevellerIcon" Glyph="&#xE994;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarStatsBtn" Grid.Column="5" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarStatsTapped"
                                ToolTipService.ToolTip="Stats for Nerbs"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="StatsIcon" Glyph="&#xE9D9;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarBypassBtn" Grid.Column="6" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarBypassTapped"
                                ToolTipService.ToolTip="Bypass Master EQ"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="BypassIcon" Glyph="&#xE711;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                    </Grid>

                    <Grid x:Name="PresetSection" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preset" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <ComboBox x:Name="PresetComboBox"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      SelectionChanged="OnPresetSelectionChanged"
                                      Background="Transparent" BorderBrush="Transparent"
                                      PointerEntered="OnPresetComboPointerEntered"
                                      PointerExited="OnPresetComboPointerExited" />
                            <TextBlock x:Name="PresetDirtyIndicator" Text="*"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Button x:Name="PresetSaveButton" Grid.Column="2" Content="Save"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="8,2" MinHeight="0" MinWidth="0"
                                Visibility="Collapsed"
                                Click="OnSavePresetClick"
                                ToolTipService.ToolTip="Save preset" />
                    </Grid>

                    <Grid x:Name="SourceSection" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Source" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="SourceComboBox" Grid.Column="1" Margin="8,0,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  SelectionChanged="OnSourceSelectionChanged"
                                  Background="Transparent" BorderBrush="Transparent"
                                  PointerEntered="OnSourceComboPointerEntered"
                                  PointerExited="OnSourceComboPointerExited">
                            <ComboBoxItem Content="USB" Tag="0" />
                            <ComboBoxItem Content="S/PDIF" Tag="1" />
                        </ComboBox>
                    </Grid>

                    <StackPanel Spacing="4">
                        <Grid>
                            <!-- Mode selector. Mirrors the macOS sidebar "User Volume ▾" /
                                 "Master Volume ▾" Menu: plain secondary-foreground text with
                                 the chevron baked in, click opens a flyout with two items
                                 and a checkmark on the active mode. -->
                            <TextBlock x:Name="SidebarVolumeModeLabel"
                                       Text="Master Volume ▾"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Tapped="OnSidebarVolumeModeLabelTapped">
                                <FlyoutBase.AttachedFlyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem x:Name="UserVolumeModeMenuItem"
                                                        Text="User Volume"
                                                        Click="OnUserVolumeModeMenuClick" />
                                        <MenuFlyoutItem x:Name="MasterVolumeModeMenuItem"
                                                        Text="Master Volume"
                                                        Click="OnMasterVolumeModeMenuClick" />
                                    </MenuFlyout>
                                </FlyoutBase.AttachedFlyout>
                            </TextBlock>
                            <TextBlock x:Name="MasterVolumeValueText" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="Cascadia Code, Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="1000"
                                StepFrequency="1" SmallChange="5" LargeChange="50"
                                IsThumbToolTipEnabled="False"
                                ValueChanged="OnMasterVolumeSliderChanged">
                            <Slider.Resources>
                                <!-- Brushes are rewritten from code-behind on mode change so
                                     master mode tints the track/thumb red (matches macOS
                                     MasterModeSection's `.tint(.red)`). -->
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource SystemAccentColor}" />
                            </Slider.Resources>
                        </Slider>
                    </StackPanel>

                </StackPanel>

                <Border Grid.Row="2" Padding="12,8" RightTapped="OnConnectionStatusRightTapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:CpuMeter x:Name="Cpu0Meter" Core="0" Label="CPU" VerticalAlignment="Center" />
                        <controls:CpuMeter x:Name="Cpu1Meter" Core="1" Visibility="Collapsed" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionIndicator" Width="7" Height="7" VerticalAlignment="Center" />
                            <Border x:Name="DeviceSelectorBtn" Background="Transparent" Padding="6,3"
                                    CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"
                                    Tapped="OnDeviceSelectorTapped"
                                    PointerEntered="OnDeviceSelectorPointerEntered"
                                    PointerExited="OnDeviceSelectorPointerExited">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="DeviceSelectorText" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <Grid x:Name="ContentGrid" Grid.Column="1" Padding="20" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="GraphArea" Grid.Row="0"
                      PointerEntered="OnGraphAreaPointerEntered"
                      PointerExited="OnGraphAreaPointerExited">
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <controls:BodePlotControl x:Name="BodePlot" />
                    </Border>
                    <Button x:Name="GraphPopoutButton"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Padding="6"
                            Background="Transparent" BorderThickness="0"
                            Opacity="0" IsHitTestVisible="False"
                            Click="OnGraphPopoutClick">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Graph resize gripper -->
                <controls:ResizeGripper x:Name="GraphGripperControl" Grid.Row="1" Height="12" Background="Transparent"
                        PointerPressed="OnGraphGripperPointerPressed"
                        PointerMoved="OnGraphGripperPointerMoved"
                        PointerReleased="OnGraphGripperPointerReleased">
                    <Rectangle Width="32" Height="3" RadiusX="1.5" RadiusY="1.5"
                               Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                               Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </controls:ResizeGripper>

                <StackPanel x:Name="LegendPanel" Grid.Row="2" Orientation="Horizontal"
                            Spacing="8" Margin="0,4,0,16" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden">
                    <Grid>
                        <StackPanel x:Name="DashboardPanel" Spacing="16">
                            <StackPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </StackPanel.ChildrenTransitions>
                        </StackPanel>
                        <StackPanel x:Name="ChannelEditorPanel" Visibility="Collapsed" Spacing="12" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>