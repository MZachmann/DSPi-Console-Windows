<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareDacMutePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        External DAC Hardware Mute page. All controls render as plain
        SettingsCards for consistency with the rest of the Hardware
        category — no Expander, no nested visual structure. Six rows:
          1. Enable toggle.
          2. Polarity (Active Low / Active High).
          3. GPIO pin selector.
          4. Hold (ms) slider — debounced staging.
          5. Release (ms) slider — debounced staging.
          6. Test-pulse button (live action, not staged).

        The first five fields all ride a single firmware command
        (REQ_SET_DAC_HW_MUTE_CONFIG) so they're combined under one
        tracker key ("hardware.dac-mute.config"). Each edit re-stages
        with the latest UI snapshot, and the tracker de-dupes.
    -->
    <StackPanel Spacing="4">

        <controls:SettingsCard Header="Enable"
                                Description="Drive a GPIO pin to mute external devices during system state changes.">
            <ToggleSwitch x:Name="EnableToggle"
                          OnContent="On" OffContent="Off"
                          Toggled="OnConfigChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Polarity"
                                Description="Active Low for PCM5102A / WM8741; Active High for AK4493 default.">
            <ComboBox x:Name="PolarityCombo" MinWidth="140"
                      SelectionChanged="OnConfigChanged">
                <ComboBoxItem Content="Active Low"/>
                <ComboBoxItem Content="Active High"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard Header="GPIO Pin"
                                Description="Connected to external device's mute input (XSMT on PCM5102A).">
            <ComboBox x:Name="PinCombo" MinWidth="180"
                      SelectionChanged="OnConfigChanged"/>
        </controls:SettingsCard>

        <!-- Hold / Release are constrained to a small set of values that
             correspond to typical DAC mute timings (5 ms = PCM5102A,
             100 ms = WM8741 / AK4493 etc.). Free-form sliders were
             error-prone and made it too easy to land on a value no
             actual DAC needs; the dropdown enumerates the useful
             options explicitly. The XAML Tag is parsed as a string at
             the handler — same gotcha as the MCK multiplier combo. -->
        <controls:SettingsCard Header="Hold (ms)"
                                Description="How long the mute pin is held asserted before clocks stop.">
            <ComboBox x:Name="HoldCombo" MinWidth="100"
                      SelectionChanged="OnConfigChanged">
                <ComboBoxItem Content="5 ms"   Tag="5"/>
                <ComboBoxItem Content="10 ms"  Tag="10"/>
                <ComboBoxItem Content="25 ms"  Tag="25"/>
                <ComboBoxItem Content="50 ms"  Tag="50"/>
                <ComboBoxItem Content="100 ms" Tag="100"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Release (ms)"
                                Description="How long to dwell after un-muting before resuming audio.">
            <ComboBox x:Name="ReleaseCombo" MinWidth="100"
                      SelectionChanged="OnConfigChanged">
                <ComboBoxItem Content="5 ms"   Tag="5"/>
                <ComboBoxItem Content="10 ms"  Tag="10"/>
                <ComboBoxItem Content="25 ms"  Tag="25"/>
                <ComboBoxItem Content="50 ms"  Tag="50"/>
                <ComboBoxItem Content="100 ms" Tag="100"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Test Pulse"
                                Description="Engages mute for one second to verify connections and settings.">
            <Button x:Name="TestButton"
                    Content="Begin Test"
                    Click="OnTestClick"/>
        </controls:SettingsCard>

        <TextBlock x:Name="TestFeedback"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
